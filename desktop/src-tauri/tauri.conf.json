{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Khatario",
  "version": "0.1.0",
  "identifier": "com.khatario.desktop",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Khatario",
        "url": "https://staging.khatario.com/login",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Khatario",
    "shortDescription": "GST billing, stock and accounts",
    "longDescription": "Khatario for Windows: GST billing, stock, WhatsApp invoices and accounts for Indian businesses.",
    "category": "Business",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0QjVEMzE2NkYwQkU0QzUKUldURjVBdHZGdE8xQk9LbjJia2pEU2VVMnB2UmU1S0UvVlVmSVpsSTNPWkNRZHBaKzJDVTBTdEQK",
      "endpoints": ["https://staging.khatario.com/desktop/updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
